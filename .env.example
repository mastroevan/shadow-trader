# =========================================================
# App / Environment
# =========================================================
NODE_ENV=development


# =========================================================
# Node API
# =========================================================
PORT=3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Server-only key used by Next.js API routes to call the Node API.
INTERNAL_API_KEY=
API_INTERNAL_BASE_URL=http://localhost:3001


# =========================================================
# Web Auth
# =========================================================
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional — Google is only shown as a sign-in option on /login if both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_ALLOWED_EMAILS=

# Alternate/legacy name accepted by the API's requireApiKey middleware
# (checked if INTERNAL_API_KEY is unset).
SHADOW_TRADER_API_KEY=


# =========================================================
# Trigger Automation
# =========================================================
# Background automation is opt-in. Manual runs are available at POST /api/automation/run.
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL_MS=900000
AUTOMATION_ENTRY_MOVE_PCT=0.01


# =========================================================
# Python FastAPI Agent
# =========================================================
# Node API will call this endpoint.
AGENT_URL=http://localhost:8000/analyze
AGENT_TIMEOUT_MS=95000


# =========================================================
# Multi-Provider AI Models (OpenAI, Anthropic, Google)
# =========================================================
SHADOW_TRADER_PROVIDER=openai
SHADOW_TRADER_MODE=fast

# OpenAI
OPENAI_API_KEY=openai-api-key-goes-here
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_DEEP=gpt-4o
OPENAI_TIMEOUT_MS=60000

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-3-5-haiku-20241022
ANTHROPIC_MODEL_DEEP=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=
GOOGLE_MODEL_FAST=gemini-2.0-flash
GOOGLE_MODEL_DEEP=gemini-1.5-pro

# =========================================================
# Broker Connectors (Alpaca Equities + Coinbase Advanced Crypto)
# =========================================================
# Alpaca Paper / Live Trading (Stocks, ETFs)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_EXECUTION_MODE=paper

# Coinbase Advanced Trade (Crypto)
# Coinbase has no paper environment: "paper" always simulates fills locally,
# even with keys set. Only "live" sends real orders.
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_BASE_URL=https://api.coinbase.com/api/v3/brokerage
COINBASE_EXECUTION_MODE=paper


# =========================================================
# Market Data / News Providers
# =========================================================
FINNHUB_API_KEY=finnhub-api-key-goes-here


# =========================================================
# Agent health check
# =========================================================
# Optional override for the API's /api/observability health check.
# Defaults to AGENT_URL with /analyze swapped for /health.
AGENT_HEALTH_URL=


# =========================================================
# Trade Risk Gate (tradeGatekeeper / tradeRiskConfig)
# All optional — defaults shown below.
# =========================================================
ACCOUNT_BALANCE=10000
RISK_PER_TRADE_PERCENT=1
MIN_RISK_REWARD_RATIO=2
MIN_CONFIDENCE_SCORE=0.75
MIN_VOLUME_RATIO=1.2
MIN_TREND_STRENGTH=0.6
COOLDOWN_HOURS_AFTER_LOSS=24


# =========================================================
# Startup Scanner
# Optional — runs a batch of analyzeSetup calls on API boot.
# =========================================================
STARTUP_SCAN_ENABLED=false
STARTUP_SCAN_TICKERS=
STARTUP_SCAN_STOCK_TICKERS=NVDA,AAPL,MSFT,TSLA,META
STARTUP_SCAN_CRYPTO_TICKERS=BTC/USD,ETH/USD,SOL/USD
STARTUP_SCAN_TIMEFRAME=5m
STARTUP_SCAN_MIN_CONFIDENCE=0.75
STARTUP_SCAN_DELAY_MS=1000


# =========================================================
# Trigger Automation Notifications
# Optional — automationScheduler posts to these if configured.
# =========================================================
DISCORD_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=


# =========================================================
# Database
# =========================================================
DATABASE_URL=postgresql://localhost:5432/shadow_trader?schema=public
