{
  "name": "shadow-trader-ledger",
  "version": "1.0.0",
  "description": "CAP ledger for Shadow Trader: theses, risk assessments, and human approvals.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "jest"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "jest": "^30"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": { "kind": "sqlite", "credentials": { "url": ":memory:" } },
        "[production]": { "kind": "hana" }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "writer":   { "password": "", "roles": ["LedgerWriter"] },
            "approver": { "password": "", "roles": ["Approver"] },
            "auditor":  { "password": "", "roles": ["Auditor"] },
            "solo":     { "password": "", "roles": ["LedgerWriter", "Approver"] }
          }
        },
        "[production]": { "kind": "xsuaa" }
      }
    }
  }
}
