{
  "name": "shadow-trader-api",
  "version": "1.0.0",
  "description": "Shadow Trader Node/TypeScript backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/index.ts",
    "build": "prisma generate && tsc",
    "db:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "test": "bash -lc 'shopt -s globstar nullglob; files=(src//*.test.ts); if ((${#files[@]})); then tsx --test `src//*.test.ts`; else echo \"No tests found, skipping\"; fi'",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.22.0",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "prisma@7.8.0": true
  }
}