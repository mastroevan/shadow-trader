{
  "scripts": {
    "proof:e2e": "node scripts/e2e_proof.mjs",
    "proof:e2e:btc": "node scripts/e2e_btc_proof.mjs"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/xssec": "^4"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "auth": {
        "kind": "xsuaa"
      }
    },
    "build": {
      "tasks": [
        {
          "for": "hana",
          "dest": "../gen/db"
        },
        {
          "for": "nodejs",
          "src": "srv",
          "dest": "../gen/srv"
        }
      ]
    }
  }
}